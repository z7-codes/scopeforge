{
  "version": 1,
  "rules": [
    {"path": "/.env", "label": "dotenv", "tier": "high", "validator": "env", "chain": ["/.env.local", "/.env.dev", "/.env.production", "/.env.backup"]},
    {"path": "/.env.local", "label": "dotenv-local", "tier": "high", "validator": "env"},
    {"path": "/.env.dev", "label": "dotenv-dev", "tier": "high", "validator": "env"},
    {"path": "/.env.production", "label": "dotenv-prod", "tier": "high", "validator": "env"},
    {"path": "/.env.backup", "label": "dotenv-backup", "tier": "high", "validator": "env"},
    {"path": "/.git/HEAD", "label": "git-head", "tier": "high", "validator": "git_head", "chain": ["/.git/config", "/.git/logs/HEAD"]},
    {"path": "/.git/config", "label": "git-config", "tier": "high", "validator": "git_config"},
    {"path": "/.git/logs/HEAD", "label": "git-log", "tier": "high", "validator": "git_log"},
    {"path": "/actuator/env", "label": "spring-env", "tier": "high", "validator": "actuator_env"},
    {"path": "/actuator/heapdump", "label": "spring-heapdump", "tier": "high", "validator": null},
    {"path": "/backup.zip", "label": "backup-zip", "tier": "high", "validator": "zip"},
    {"path": "/db.sql", "label": "sql-dump", "tier": "high", "validator": "sql"},
    {"path": "/dump.sql", "label": "sql-dump", "tier": "high", "validator": "sql"},
    {"path": "/.aws/credentials", "label": "aws-credentials", "tier": "high", "validator": "aws"},
    {"path": "/openapi.json", "label": "openapi", "tier": "medium", "validator": "openapi"},
    {"path": "/swagger.json", "label": "swagger", "tier": "medium", "validator": "openapi"},
    {"path": "/swagger", "label": "swagger-ui", "tier": "medium", "validator": "openapi"},
    {"path": "/api-docs", "label": "api-docs", "tier": "medium", "validator": "openapi"},
    {"path": "/graphql", "label": "graphql", "tier": "medium", "validator": "graphql"},
    {"path": "/actuator", "label": "spring-actuator", "tier": "medium", "validator": "actuator"},
    {"path": "/phpinfo.php", "label": "phpinfo", "tier": "medium", "validator": "phpinfo"},
    {"path": "/server-status", "label": "apache-status", "tier": "medium", "validator": "server_status"},
    {"path": "/server-info", "label": "apache-info", "tier": "medium", "validator": "server_info"},
    {"path": "/package.json", "label": "npm-manifest", "tier": "medium", "validator": "manifest"},
    {"path": "/composer.json", "label": "composer-manifest", "tier": "medium", "validator": "manifest"},
    {"path": "/firebase.json", "label": "firebase-config", "tier": "medium", "validator": "firebase"},
    {"path": "/Dockerfile", "label": "dockerfile", "tier": "medium", "validator": "dockerfile"},
    {"path": "/WEB-INF/web.xml", "label": "web-xml", "tier": "medium", "validator": "web_xml"},
    {"path": "/.idea/workspace.xml", "label": "jetbrains-workspace", "tier": "medium", "validator": "idea"},
    {"path": "/elmah.axd", "label": "elmah", "tier": "medium", "validator": "elmah"},
    {"path": "/.htaccess", "label": "htaccess", "tier": "low", "validator": "htaccess"},
    {"path": "/.svn/entries", "label": "svn-entries", "tier": "low", "validator": "svn"},
    {"path": "/.DS_Store", "label": "ds-store", "tier": "low", "validator": "ds_store"},
    {"path": "/robots.txt", "label": "robots", "tier": "low", "validator": "robots"},
    {"path": "/sitemap.xml", "label": "sitemap", "tier": "low", "validator": "sitemap"},
    {"path": "/.well-known/security.txt", "label": "security-txt", "tier": "low", "validator": "security_txt"}
  ]
}
