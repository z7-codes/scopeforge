{
  "version": 1,
  "categories": {
    "directory-listing": {
      "description": "Publicly indexed directory indexes and browseable folders.",
      "templates": [
        "site:{domain} intitle:\"Index of /\"",
        "site:{domain} intitle:\"Index of /admin\"",
        "site:{domain} intitle:\"Index of /old\"",
        "site:{domain} intitle:\"Index of /test\"",
        "site:{domain} intitle:\"Index of /dev\"",
        "site:{domain} intitle:\"Index of /backup\"",
        "site:{domain} intitle:\"Index of /uploads\"",
        "site:{domain} intitle:\"Index of /static\"",
        "site:{domain} intitle:\"Index of /assets\"",
        "site:{domain} intitle:\"Index of /private\"",
        "site:{domain} \"Index of /\" \"Parent Directory\"",
        "site:{domain} \"Directory listing for /\""
      ]
    },
    "sensitive-files": {
      "description": "Sensitive filenames that may be publicly indexed.",
      "templates": [
        "site:{domain} filetype:env \".env\"",
        "site:{domain} inurl:/.env",
        "site:{domain} inurl:/.git/HEAD",
        "site:{domain} inurl:/.git/config",
        "site:{domain} inurl:/.svn/entries",
        "site:{domain} inurl:/.hg/store",
        "site:{domain} inurl:/.DS_Store",
        "site:{domain} inurl:/.htaccess",
        "site:{domain} inurl:/.htpasswd",
        "site:{domain} filetype:ini inurl:config",
        "site:{domain} filetype:properties inurl:config",
        "site:{domain} filetype:yaml inurl:config",
        "site:{domain} filetype:yml inurl:config",
        "site:{domain} filetype:toml inurl:config",
        "site:{domain} inurl:/private inurl:key",
        "site:{domain} inurl:/id_rsa",
        "site:{domain} inurl:/credentials",
        "site:{domain} inurl:/secrets"
      ]
    },
    "backups-archives": {
      "description": "Indexed backup, archive, and database dump files.",
      "templates": [
        "site:{domain} filetype:bak",
        "site:{domain} filetype:backup",
        "site:{domain} filetype:old",
        "site:{domain} filetype:zip inurl:backup",
        "site:{domain} filetype:rar inurl:backup",
        "site:{domain} filetype:tar inurl:backup",
        "site:{domain} filetype:gz inurl:backup",
        "site:{domain} filetype:sql inurl:dump",
        "site:{domain} filetype:sql inurl:backup",
        "site:{domain} filetype:7z inurl:backup",
        "site:{domain} inurl:/backup/ filetype:zip",
        "site:{domain} inurl:/old/ filetype:sql",
        "site:{domain} inurl:/archive/ filetype:tar.gz",
        "site:{domain} ext:bak ext:old ext:zip"
      ]
    },
    "config-and-secrets": {
      "description": "Public references to configuration files and secret material.",
      "templates": [
        "site:{domain} \"API_KEY\"",
        "site:{domain} \"SECRET_KEY\"",
        "site:{domain} \"ACCESS_TOKEN\"",
        "site:{domain} \"aws_access_key_id\"",
        "site:{domain} \"secret_access_key\"",
        "site:{domain} \"database_password\"",
        "site:{domain} \"DB_PASSWORD\"",
        "site:{domain} \"private_key\"",
        "site:{domain} \"BEGIN RSA PRIVATE KEY\"",
        "site:{domain} \"BEGIN OPENSSH PRIVATE KEY\"",
        "site:{domain} filetype:env \"KEY\"",
        "site:{domain} filetype:json inurl:config",
        "site:{domain} inurl:docker-compose.yml",
        "site:{domain} inurl:.aws/credentials",
        "site:{domain} inurl:wp-config.php"
      ]
    },
    "source-control": {
      "description": "Indexed source-control metadata and repository files.",
      "templates": [
        "site:{domain} inurl:/.git/",
        "site:{domain} intitle:\"Index of /.git\"",
        "site:{domain} filetype:gitconfig",
        "site:{domain} inurl:/.gitlab/",
        "site:{domain} inurl:/.github/",
        "site:{domain} inurl:/.svn/",
        "site:{domain} inurl:/.hg/",
        "site:{domain} inurl:/.idea/",
        "site:{domain} inurl:/.vscode/",
        "site:{domain} filetype:gitmodules",
        "site:{domain} inurl:/bitbucket/",
        "site:{domain} inurl:/repository/"
      ]
    },
    "logs-and-debug": {
      "description": "Exposed logs, debug pages, and diagnostic output.",
      "templates": [
        "site:{domain} filetype:log",
        "site:{domain} inurl:/logs/",
        "site:{domain} inurl:/debug/",
        "site:{domain} inurl:/trace",
        "site:{domain} \"PHP Info\"",
        "site:{domain} intitle:phpinfo",
        "site:{domain} inurl:/phpinfo.php",
        "site:{domain} \"Stack trace\"",
        "site:{domain} \"Fatal error\"",
        "site:{domain} \"Warning:\" filetype:log",
        "site:{domain} inurl:/actuator/",
        "site:{domain} inurl:/metrics"
      ]
