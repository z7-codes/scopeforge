        "site:{domain} inurl:/xmlrpc.php",
        "site:{domain} inurl:/wp-config.php",
        "site:{domain} \"wp-json\"",
        "site:{domain} inurl:/joomla/",
        "site:{domain} inurl:/drupal/",
        "site:{domain} inurl:/sites/default/files/",
