        "site:{domain} inurl:/graphql",
        "site:{domain} \"swagger-ui\"",
        "site:{domain} \"OpenAPI\"",
        "site:{domain} filetype:json inurl:api",
        "site:{domain} filetype:yaml inurl:api",
        "site:{domain} inurl:/docs/",
        "site:{domain} inurl:/developer/",
        "site:{domain} inurl:/webhook"
