        "site:{domain} inurl:/security.txt",
        "site:{domain} inurl:/.well-known/",
        "site:{domain} filetype:txt inurl:security",
        "site:{domain} inurl:/ads.txt",
        "site:{domain} inurl:/humans.txt",
        "site:{domain} inurl:/crossdomain.xml",
