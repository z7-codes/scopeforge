        "site:{domain} inurl:/admin",
        "site:{domain} inurl:/administrator",
        "site:{domain} inurl:/wp-admin",
        "site:{domain} inurl:/adminer",
        "site:{domain} inurl:/phpmyadmin",
        "site:{domain} inurl:/manager/html",
        "site:{domain} inurl:/jenkins",
        "site:{domain} intitle:\"Jenkins Dashboard\"",
        "site:{domain} intitle:\"Grafana\"",
        "site:{domain} inurl:/kibana",
        "site:{domain} inurl:/solr",
        "site:{domain} inurl:/console"
      ]
