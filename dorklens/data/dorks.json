        "\"{domain}\" site:github.com",
        "\"{domain}\" site:gitlab.com",
        "\"{domain}\" site:stackoverflow.com",
        "\"{domain}\" site:reddit.com",
        "\"{domain}\" \"api_key\"",
        "\"{domain}\" \"password\"",
        "\"{domain}\" \"secret\"",
        "\"{domain}\" \"token\""
      ]
