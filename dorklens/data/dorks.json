        "site:{domain} \"Django\"",
        "site:{domain} \"Laravel\"",
        "site:{domain} \"Express\"",
        "site:{domain} \"nginx\"",
        "site:{domain} \"Apache\"",
        "site:{domain} \"ASP.NET\"",
        "site:{domain} \"React\"",
        "site:{domain} \"Vue\"",
        "site:{domain} \"WordPress\"",
        "site:{domain} \"Shopify\"",
        "site:{domain} \"Cloudflare\""
